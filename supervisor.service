[Unit]
Description=Supervisor - Service Manager
After=network.target

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/Code/supervisor
ExecStart=/home/sam/venv/bin/python3 /home/sam/Code/supervisor/run.py
Restart=always
RestartSec=5
EnvironmentFile=/home/sam/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/sam/venv/bin:/home/sam/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
